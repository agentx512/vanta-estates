[Unit]
Description=VANTA ESTATES real estate demo
After=network.target

[Service]
Type=simple
User=agent512
Group=www-data
WorkingDirectory=/var/www/realestatedemo
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/usr/bin/node /var/www/realestatedemo/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
